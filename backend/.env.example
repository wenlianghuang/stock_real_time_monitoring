# Copy this file to ".env" and fill in values.
# DO NOT commit your real ".env" file.

# mock | fugle
PROVIDER=fugle

# Fugle MarketData API key
FUGLE_API_KEY=

# comma-separated TW stock symbols
FUGLE_SYMBOLS=2330,2308,2317

# optional server config
ADDR=:8080
SNAPSHOT_EVERY=1s
SPARK_WINDOW=30m

